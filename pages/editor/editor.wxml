<view class="editor-page">
  <view wx:if="{{state === 'loading'}}" class="hint">{{loadingDetail}}</view>
  <view wx:if="{{state === 'ready'}}" class="hint">AI 已根据照片内容生成一版白色手写 PLOG</view>
  <view wx:if="{{state === 'unavailable'}}" class="hint hint-error">{{errorMessage}}</view>
  <view class="photo-card" style="height: {{cardHeight}}rpx;">
    <image class="photo" src="{{generatedImageUrl || photoPath}}" mode="aspectFit" />
    <view class="wash"></view>
  <view wx:if="{{state === 'loading'}}" class="loading-mask">
    <view class="loader"></view>
    <text class="loading-title">{{loadingTitle}}</text>
    <text class="loading-detail">{{loadingDetail}}</text>
  </view>
  </view>

  <block wx:if="{{state === 'ready'}}"><button class="save-button" loading="{{saving}}" bindtap="save">{{saved ? '已保存，去分享' : '保存并分享'}}</button><button class="regenerate" bindtap="regenerate">重新生成一版</button></block>
  <view wx:if="{{state === 'ready'}}" class="disclaimer">图片由 AI 根据上传照片生成，可继续换一版或微调。</view>
  <view wx:if="{{state === 'unavailable'}}" class="unavailable-box">这张照片没有生成成功，也不会扣除创作次数。请返回后重新选择照片再试。</view>
</view>
