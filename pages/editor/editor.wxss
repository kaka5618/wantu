.editor-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 32rpx 52rpx; background: #fffdf9; }
.hint { margin: 6rpx 8rpx 26rpx; color: #858b99; font-size: 24rpx; }
.hint-error { color: #ba7657; }
.photo-card { position: relative; overflow: hidden; border-radius: 30rpx; background: #d6dfce; box-shadow: 0 18rpx 40rpx rgba(57, 70, 58, .18); }
.photo { width: 100%; height: 100%; }
.wash { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(27,36,26,.09), transparent 46%, rgba(28,38,28,.08)); }
.loading-mask { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 44rpx; box-sizing: border-box; color: #fff; text-align: center; background: rgba(43, 55, 46, .42); font-size: 27rpx; }
.loader { width: 58rpx; height: 58rpx; box-sizing: border-box; border: 6rpx solid rgba(255,255,255,.38); border-top-color: #fff; border-radius: 50%; animation: spin 1s linear infinite; }
.loading-title { margin-top: 12rpx; font-size: 30rpx; font-weight: 600; }
.loading-detail { max-width: 520rpx; color: rgba(255,255,255,.88); font-size: 23rpx; line-height: 1.55; }
.doodle { position: absolute; display: flex; align-items: center; justify-content: center; color: #fffdf8; text-shadow: 0 2rpx 8rpx rgba(27, 34, 25, .22); }
.heart { right: 46rpx; top: 94rpx; font-size: 88rpx; transform: rotate(10deg); }
.star { right: 105rpx; top: 200rpx; font-size: 58rpx; color: #ffe07d; }
.arrow { right: 70rpx; bottom: 125rpx; font-size: 72rpx; transform: rotate(12deg); }
.leaf { left: 50rpx; bottom: 182rpx; font-size: 92rpx; transform: rotate(36deg); }
.tool-row { display: flex; gap: 16rpx; margin: 30rpx 0 38rpx; }
.tool { flex: 1; margin: 0; padding: 0; height: 72rpx; line-height: 72rpx; color: #687381; border: 2rpx solid #ece9e2; border-radius: 36rpx; background: #fff; font-size: 24rpx; }
.save-button { height: 98rpx; line-height: 98rpx; color: #fff; border-radius: 49rpx; background: #587da2; font-size: 30rpx; font-weight: 600; box-shadow: 0 12rpx 22rpx rgba(68, 103, 135, .18); }
.regenerate { margin-top: 22rpx; padding: 0; color: #657d95; background: transparent; font-size: 25rpx; }
.disclaimer { margin-top: 24rpx; color: #9a9ca4; text-align: center; font-size: 20rpx; }
.unavailable-box { margin-top: 30rpx; padding: 25rpx; border-radius: 20rpx; color: #8f6c54; background: #fff3e8; font-size: 24rpx; line-height: 1.65; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
