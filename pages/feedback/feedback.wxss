.feedback-page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 32rpx 64rpx; background: #fffaf2; }
.hero-card { position: relative; overflow: hidden; padding: 35rpx 30rpx 32rpx; border-radius: 30rpx; background: #FFE25A; box-shadow: 0 14rpx 28rpx rgba(188, 156, 32, .14); }
.hero-kicker { color: #587093; font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }
.page-title { position: relative; z-index: 1; margin-top: 15rpx; color: #132C62; font-size: 39rpx; font-weight: 800; }
.page-copy { position: relative; z-index: 1; width: 82%; margin-top: 13rpx; color: #4c6088; font-size: 23rpx; line-height: 1.65; }
.rabbit-doodle { position: absolute; right: 26rpx; bottom: 23rpx; color: #132C62; font-size: 55rpx; font-weight: 800; letter-spacing: -8rpx; transform: rotate(-8deg); }
.form-card { margin-top: 24rpx; padding: 30rpx 28rpx; border: 2rpx solid #efe6d9; border-radius: 30rpx; background: #fff; box-shadow: 0 10rpx 24rpx rgba(35, 47, 78, .05); }
.field-title { color: #132C62; font-size: 26rpx; font-weight: 800; }
.field-title text { color: #959baa; font-size: 20rpx; font-weight: 400; }
.type-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.type-chip { padding: 14rpx 18rpx; border: 2rpx solid #e5e8ee; border-radius: 99rpx; color: #69778e; background: #fff; font-size: 22rpx; }
.type-chip-active { border-color: #132C62; color: #132C62; background: #fff4b6; font-weight: 800; }
.field-row { display: flex; align-items: center; justify-content: space-between; margin-top: 34rpx; }
.count { color: #a1a7b2; font-size: 20rpx; }
.feedback-textarea { display: block; width: 100%; min-height: 190rpx; box-sizing: border-box; margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; color: #253858; background: #f8f8f5; font-size: 25rpx; line-height: 1.55; }
.placeholder { color: #afb4bc; }
.image-title { margin-top: 31rpx; }
.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.image-item, .add-image { position: relative; width: 144rpx; height: 144rpx; overflow: hidden; border-radius: 18rpx; }
.image-item image { width: 100%; height: 100%; }
.remove-image { position: absolute; top: 7rpx; right: 7rpx; display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border-radius: 50%; color: #fff; background: rgba(19, 44, 98, .75); font-size: 32rpx; line-height: 1; }
.add-image { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #cbd2dc; color: #8490a3; background: #fbfcfd; font-size: 19rpx; }
.add-image text { margin-bottom: 4rpx; color: #132C62; font-size: 42rpx; line-height: 1; }
.contact-title { margin-top: 32rpx; }
.contact-input { height: 84rpx; box-sizing: border-box; margin-top: 18rpx; padding: 0 22rpx; border-radius: 18rpx; color: #253858; background: #f8f8f5; font-size: 24rpx; }
.submit-button, .back-button { height: 94rpx; margin-top: 30rpx; border-radius: 48rpx; color: #fff; background: #132C62; font-size: 29rpx; font-weight: 800; line-height: 94rpx; box-shadow: 0 14rpx 24rpx rgba(19,44,98,.16); }
.privacy-note { margin-top: 19rpx; color: #a0a5af; text-align: center; font-size: 20rpx; }
.success-card { display: flex; min-height: 680rpx; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; padding: 48rpx; border-radius: 34rpx; background: #fff; text-align: center; box-shadow: 0 12rpx 26rpx rgba(19,44,98,.08); }
.rabbit-mark { color: #132C62; font-size: 84rpx; font-weight: 800; letter-spacing: -13rpx; transform: rotate(-7deg); }
.success-title { margin-top: 35rpx; color: #132C62; font-size: 42rpx; font-weight: 800; }
.success-copy { margin-top: 18rpx; color: #788398; font-size: 24rpx; line-height: 1.7; }
.back-button { width: 100%; margin-top: 46rpx; }
