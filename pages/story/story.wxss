.story-page{min-height:100vh;box-sizing:border-box;padding:30rpx 32rpx 52rpx;background:#fffdf9}.hint{margin:6rpx 8rpx 26rpx;color:#858b99;font-size:24rpx}.error{color:#ba7657}.story-card{position:relative;overflow:hidden;border-radius:30rpx;background:#eee8dc;box-shadow:0 18rpx 40rpx rgba(57,70,58,.18);min-height:900rpx}.story-card image{width:100%;height:900rpx}.loading-mask{position:absolute;inset:0;display:flex;flex-direction:column;gap:16rpx;align-items:center;justify-content:center;padding:44rpx;box-sizing:border-box;color:#fff;text-align:center;background:rgba(43,55,46,.42);font-size:23rpx}.loading-title{font-size:30rpx;font-weight:600}.loader{width:58rpx;height:58rpx;box-sizing:border-box;border:6rpx solid rgba(255,255,255,.38);border-top-color:#fff;border-radius:50%;animation:spin 1s linear infinite}.save{height:98rpx;margin-top:30rpx;line-height:98rpx;color:#fff;border-radius:49rpx;background:#132C62;font-size:30rpx;font-weight:600}.again{margin-top:22rpx;padding:0;color:#657d95;background:transparent;font-size:25rpx}.failed{margin-top:30rpx;padding:25rpx;border-radius:20rpx;color:#8f6c54;background:#fff3e8;font-size:24rpx;line-height:1.65}@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
