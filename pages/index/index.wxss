.page-shell { min-height: 100vh; box-sizing: border-box; padding: 0 0 48rpx; background: #fffdf7; }
.brand-hero { position: relative; min-height: 310rpx; overflow: hidden; padding-top: 34rpx; border-radius: 0 0 48rpx 48rpx; background: #FFE25A; }
.top-row { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 0 38rpx; }
.top-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 11rpx; }
.brand-block { display: flex; align-items: center; gap: 15rpx; }
.brand { color: #132C62; font-size: 56rpx; font-weight: 800; letter-spacing: 1rpx; line-height: .92; }
.brand-en { margin-top: 8rpx; color: #132C62; font-size: 21rpx; font-weight: 700; letter-spacing: 4rpx; line-height: 1; }
.history-link, .message-link { box-sizing: border-box; width: 164rpx; padding: 13rpx 12rpx; border-radius: 99rpx; color: #132C62; background: rgba(255,253,247,.76); font-size: 23rpx; font-weight: 700; text-align: center; }
.all-link { color: #132C62; font-size: 23rpx; font-weight: 700; }
.history-link text, .all-link text, .feature-action text { font-size: 34rpx; vertical-align: -2rpx; }
.intro { position: relative; z-index: 2; margin: 40rpx 40rpx 0; }
.intro-title { color: #132C62; font-size: 43rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1.08; }
.intro-accent { color: #E5674B; }
.intro-subtitle { margin-top: 12rpx; color: #53648a; font-size: 25rpx; }
.hero-rabbit { position: absolute; right: -16rpx; bottom: -18rpx; width: 272rpx; height: 272rpx; }
.content { padding: 0 32rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 8rpx 22rpx; }
.recent-head { display: flex; align-items: center; justify-content: space-between; margin: 0 40rpx 22rpx; }
.section-title { color: #132C62; font-size: 37rpx; font-weight: 800; }
.section-note { color: #8b94a9; font-size: 21rpx; }
.feature-card { position: relative; height: 470rpx; overflow: hidden; border-radius: 32rpx; background: #132C62; box-shadow: 0 18rpx 32rpx rgba(19,44,98,.16); }
.feature-image { width: 100%; height: 100%; }
.feature-shade { position: absolute; right: 0; bottom: 0; left: 0; height: 56%; background: linear-gradient(transparent, rgba(15,27,57,.82)); }
.feature-label { position: absolute; top: 20rpx; left: 20rpx; padding: 9rpx 16rpx; border-radius: 99rpx; color: #132C62; background: #fffdf7; font-size: 20rpx; font-weight: 700; }
.feature-copy { position: absolute; right: 28rpx; bottom: 27rpx; left: 28rpx; color: #fff; }
.feature-title { font-size: 33rpx; font-weight: 800; }
.feature-desc { margin-top: 8rpx; font-size: 21rpx; line-height: 1.45; opacity: .9; }
.ready-card { display: flex; align-items: center; gap: 22rpx; margin-top: 28rpx; padding: 18rpx; border: 3rpx solid #132C62; border-radius: 28rpx; background: #fff; box-shadow: 0 14rpx 28rpx rgba(19,44,98,.12); }
.ready-preview { width: 142rpx; height: 142rpx; flex: 0 0 142rpx; border-radius: 20rpx; background: #eef0f4; }
.ready-copy { min-width: 0; flex: 1; }
.ready-title { color: #132C62; font-size: 27rpx; font-weight: 800; }
.ready-note { margin-top: 7rpx; color: #737d92; font-size: 20rpx; line-height: 1.45; }
.ready-actions { display: flex; align-items: center; gap: 15rpx; margin-top: 16rpx; }
.replace-photo { padding: 12rpx 6rpx; color: #65738c; font-size: 22rpx; }
.start-create { flex: 1; margin: 0; padding: 0 18rpx; height: 62rpx; line-height: 62rpx; border-radius: 99rpx; color: #fffdf7; background: #132C62; font-size: 23rpx; font-weight: 800; }
.start-create text { font-size: 30rpx; vertical-align: -1rpx; }
.choose-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; padding: 23rpx 25rpx; border: 2rpx solid #f0e6d8; border-radius: 26rpx; background: #fff; }
.choose-copy { min-width: 0; flex: 1; }
.choose-title { color: #132C62; font-size: 32rpx; font-weight: 800; }
.choose-note { margin-top: 9rpx; color: #7d8798; font-size: 20rpx; line-height: 1.45; }
.choose-actions { display: flex; flex: 0 0 190rpx; flex-direction: column; align-items: center; }
.choose-button { width: 190rpx; height: 66rpx; margin: 0; border-radius: 99rpx; color: #fff; background: #E5674B; font-size: 22rpx; font-weight: 800; line-height: 66rpx; }
.camera-link { margin-top: 10rpx; color: #65738c; font-size: 19rpx; text-align: center; }
.next-section { margin-top: 38rpx; }
.story-cover-card { height: 540rpx; overflow: hidden; border-radius: 32rpx; background: #dfe9ef; box-shadow: 0 18rpx 32rpx rgba(19,44,98,.12); }
.story-cover-swiper { width: 100%; height: 540rpx; }
.story-page-cover { height: 540rpx; margin: 0 5rpx; overflow: hidden; border-radius: 28rpx; background: #dfe9ef; box-shadow: 0 12rpx 24rpx rgba(19,44,98,.16); }
.story-cover-image { width: 100%; height: 100%; }
.story-cover-loading { position: relative; height: 100%; overflow: hidden; }
.coming-copy { position: relative; z-index: 1; box-sizing: border-box; width: 68%; padding: 30rpx 28rpx; }
.coming-label { display: inline-block; padding: 8rpx 15rpx; border-radius: 99rpx; color: #132C62; background: #fffdf7; font-size: 20rpx; font-weight: 700; }
.coming-title { margin-top: 18rpx; color: #132C62; font-size: 31rpx; font-weight: 800; line-height: 1.28; }
.coming-desc { margin-top: 12rpx; color: #60718b; font-size: 20rpx; line-height: 1.5; }
.coming-rabbit { position: absolute; right: -22rpx; bottom: -35rpx; width: 280rpx; height: 280rpx; }
.story-choose-card { margin-top: 20rpx; }
.story-button { background: #132C62; }
.quota { margin-top: 32rpx; color: #8c95a5; text-align: center; font-size: 21rpx; }
.feedback-link { margin-top: 22rpx; color: #65738c; text-align: center; font-size: 22rpx; }
.feedback-dot { color: #E5674B; font-size: 16rpx; vertical-align: 1rpx; }
